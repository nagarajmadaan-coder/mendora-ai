# MENDORA Docker configuration — EXAMPLE ONLY. Contains NO real secrets.
# Copy to `docker.env` (same folder as docker-compose.yml) and fill in your own values.
# docker.env is in .gitignore — never commit or share it.

# ---------- Required ----------
MENDORA_ENVIRONMENT=production
# Long random secret for login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
MENDORA_JWT_SECRET=replace-with-a-long-random-secret

# The address people open in their browser (CORS). Same-site via nginx, so this is the frontend address.
MENDORA_CORS_ORIGINS=http://localhost:8080

# ---------- Demo data ----------
# true = show clearly-labelled SAMPLE technicians (create them with the seed command in docs/DOCKER.md).
# Set to false for a real deployment.
MENDORA_DEMO_MODE=true

# ---------- Optional ----------
# Interactive API docs at /docs are OFF in production. They are not exposed through nginx either.
# MENDORA_API_DOCS=false
MENDORA_TIMEZONE=Asia/Kolkata
MENDORA_CURRENCY=INR
# Payments are a SANDBOX simulation only (no real money). "none" switches them off.
MENDORA_PAYMENT_PROVIDER=sandbox

# ---------- AI diagnosis (not configured yet) ----------
# Leave as "none" until a provider is set up and tested. The rest of MENDORA works without it.
MENDORA_AI_PROVIDER=none
# Nebius Token Factory:
# MENDORA_AI_PROVIDER=nebius
# MENDORA_AI_MODEL=openai/gpt-oss-120b
# NEBIUS_API_KEY=your-nebius-api-key-here
# Test inside the container:  docker compose exec backend python -m app.cli check-ai

# ---------- AI web research (optional; Tavily summary of web pages, not a diagnosis) ----------
# TAVILY_API_KEY=your-tavily-api-key-here
