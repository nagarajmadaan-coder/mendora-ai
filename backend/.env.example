# MENDORA backend configuration — EXAMPLE ONLY. Contains NO real secrets.
# To use: copy this file to `backend/.env` and replace the placeholder values.
# `.env` is listed in .gitignore — never commit it or share it.

# ---------- General ----------
MENDORA_ENVIRONMENT=development
# Browser origins allowed to call the API (comma-separated). 5173 = npm run dev, 4173 = npm run preview
MENDORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---------- Database ----------
# Default: a SQLite file called mendora.db in the backend folder (created automatically).
# MENDORA_DATABASE_URL=sqlite:///./mendora.db

# ---------- Authentication ----------
# REQUIRED to keep people signed in across restarts (and required in production).
# Generate your own with:   python -c "import secrets; print(secrets.token_urlsafe(64))"
MENDORA_JWT_SECRET=replace-with-a-long-random-secret
MENDORA_ACCESS_TOKEN_MINUTES=60

# ---------- AI diagnosis ----------
# Provider: anthropic (default) | nebius | openai | tavily | none
# tavily = TRIAL ONLY: shows a Tavily web-search summary instead of a full AI diagnosis (uses TAVILY_API_KEY below).
MENDORA_AI_PROVIDER=anthropic
# Leave empty to use the default model (anthropic: claude-sonnet-5-5, nebius: openai/gpt-oss-120b).
# OpenAI requires a model name here.
MENDORA_AI_MODEL=

# Your provider API key (only the one for the chosen provider is needed). Keep it secret; never put it in frontend code.
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Nebius Token Factory: https://tokenfactory.nebius.com  (use with MENDORA_AI_PROVIDER=nebius)
# NEBIUS_API_KEY=your-nebius-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
#
# After setting a key, test it with:   python -m app.cli check-ai

# ---------- AI web research (optional, separate from the AI diagnosis) ----------
# Tavily searches the web and writes a short AI summary with sources (https://app.tavily.com → API keys).
# It is NOT a diagnosis. Off when empty. Test with:   python -m app.cli check-web-research
# TAVILY_API_KEY=your-tavily-api-key-here

# Optional: an OpenAI-compatible endpoint instead of api.openai.com (with MENDORA_AI_PROVIDER=openai)
# MENDORA_AI_BASE_URL=

MENDORA_AI_TIMEOUT_SECONDS=45
MENDORA_DIAGNOSES_PER_USER_PER_HOUR=20

# ---------- Bookings, technicians & demo (Steps 8–9) ----------
# Timezone used for working hours and the times shown to people (IANA name).
MENDORA_TIMEZONE=Asia/Kolkata
# Currency for technician rates (3-letter code). No payments are taken.
MENDORA_CURRENCY=INR
# Working hours for bookings, in MENDORA_TIMEZONE (24-hour clock).
MENDORA_WORKING_HOURS_START=9
MENDORA_WORKING_HOURS_END=18
MENDORA_BOOKING_MIN_NOTICE_MINUTES=60
MENDORA_BOOKING_MAX_DAYS_AHEAD=60
MENDORA_BOOKINGS_PER_USER_PER_HOUR=20
# Demo mode shows clearly-labelled SAMPLE technicians (create them with: python -m app.cli seed-demo).
# Leave unset: ON in development, OFF when MENDORA_ENVIRONMENT=production.
# MENDORA_DEMO_MODE=true

# ---------- Payments (Step 10) ----------
# SANDBOX only: a simulated provider. No real money is taken and no card details are collected.
# "none" switches payments off.
MENDORA_PAYMENT_PROVIDER=sandbox
MENDORA_PAYMENTS_PER_USER_PER_HOUR=30
# Platform fee shown in price breakdowns (sandbox — nothing is collected)
MENDORA_PLATFORM_COMMISSION_PERCENT=10

# ---------- Photos ----------
# Folder for uploaded photos (location data is removed). Default: backend/uploads
# MENDORA_UPLOAD_DIR=
MENDORA_PHOTO_MAX_MB=10
MENDORA_PHOTOS_PER_REQUEST=3

# ---------- API docs ----------
# Interactive docs at /docs: leave unset = ON in development, OFF in production.
# MENDORA_API_DOCS=true
