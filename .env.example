# MENDORA frontend configuration — EXAMPLE ONLY (no secrets).
# To use: copy this file to `.env` (same folder as package.json), then restart `npm run dev`.
# Never put secrets here: every VITE_ variable is visible to anyone using the website.

# Address of the FastAPI backend.
#   - Not set            → http://localhost:8000 (local development)
#   - Set to empty value  → same website as the frontend (used by the Docker setup, where nginx forwards /api)
#   - A full URL          → a backend hosted elsewhere, e.g. https://api.example.com (also add it to MENDORA_CORS_ORIGINS)
VITE_API_BASE_URL=http://localhost:8000
